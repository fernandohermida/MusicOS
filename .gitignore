# beets is a runtime dependency installed separately (see docs/SETUP.md) —
# it's never vendored into this repo, so there's nothing beets-related to
# ignore here beyond BEETSDIR's own contents below.

# BEETSDIR contents: nothing under here is tracked. config.yaml is
# machine-specific (real directory: paths, and it can carry API keys, e.g.
# acoustid.apikey) — beetsdir/config.example.yaml at the repo root is the
# tracked template instead. The DB, logs, and scratch exports are local and
# can be large.
/beetsdir/library.db
/beetsdir/library.db-*
/beetsdir/state.pickle
/beetsdir/logs/
/beetsdir/exports/
/beetsdir/config.yaml
/beetsdir/venv/

# Never accidentally track the music collection itself, in case it's ever
# nested under MusicOS instead of kept fully external.
/music/

# Standard Python/OS noise
__pycache__/
*.pyc
.DS_Store
Thumbs.db
